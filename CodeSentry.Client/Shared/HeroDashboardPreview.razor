                <div class="sidebar-icon w-6 h-6 rounded bg-[#1F2937]/50"></div>
                <div class="sidebar-icon w-6 h-6 rounded bg-[#1F2937]/50"></div>
                <div class="sidebar-icon w-6 h-6 rounded bg-[#1F2937]/50"></div>
                <div class="sidebar-icon w-6 h-6 rounded bg-[#1F2937]/50"></div>
            </div>

            <!-- Main Content Area -->
            <div class="flex-1 bg-[#080A0F] p-4 flex flex-col gap-4 overflow-hidden relative">
                
