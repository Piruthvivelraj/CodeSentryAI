                <div class="w-2.5 h-2.5 rounded-full bg-[#EF4444]"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-[#F59E0B]"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-[#10B981]"></div>
            </div>
            <!-- Fake URL -->
            <div class="absolute left-1/2 -translate-x-1/2 flex items-center justify-center bg-[#1F2937]/50 rounded-md px-4 py-1 text-[10px] text-outline font-body-md w-64">
