<div class="relative w-full max-w-[860px] mx-auto hero-dashboard-preview">
    <!-- Outer Wrapper -->
    <div class="bg-[#0F1117] border border-[#1F2937] rounded-xl overflow-hidden shadow-[0_0_60px_rgba(59,130,246,0.15),0_0_120px_rgba(139,92,246,0.08)] flex flex-col relative w-full aspect-[16/9]">
        
        <!-- Fake Browser Bar -->
        <div class="h-8 bg-[#0F1117] border-b border-[#1F2937] flex items-center px-4 shrink-0 relative">
