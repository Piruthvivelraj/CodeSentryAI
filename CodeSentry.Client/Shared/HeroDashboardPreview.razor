                                <linearGradient id="chartGradient" x1="0" x2="0" y1="0" y2="1">
                                    <stop offset="0%" stop-color="rgba(59,130,246,0.3)"></stop>
                                    <stop offset="100%" stop-color="transparent"></stop>
                                </linearGradient>
                            </defs>
                            <path d="M0,65 C50,60 80,55 120,45 S180,30 220,25 S300,15 350,10 S380,8 400,5 L400,80 L0,80 Z" fill="url(#chartGradient)"></path>
                            <path class="chart-line" d="M0,65 C50,60 80,55 120,45 S180,30 220,25 S300,15 350,10 S380,8 400,5" fill="none" stroke="#3B82F6" stroke-width="2" style="filter: drop-shadow(0 0 4px #3B82F6);"></path>
                        </svg>
                    </div>
                </div>

                <!-- Repository Table -->
                <div class="h-[100px] bg-[#0F1117] border border-[#1F2937] rounded-lg flex flex-col shrink-0 overflow-hidden">
