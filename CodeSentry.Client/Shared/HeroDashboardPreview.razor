                        <div class="repo-row flex items-center justify-between py-1 border-l-2 border-l-[#10B981] pl-2">
                            <span class="text-accent w-[30%] truncate">SYS_CORE_V2</span>
                            <div class="w-[40%] flex items-center gap-2">
                                <div class="flex-1 h-1 bg-[#1F2937] rounded-full overflow-hidden">
                                    <div class="h-full bg-[#10B981] shadow-[0_0_4px_#10B981] progress-bar-fill" style="--fill-width: 92%;"></div>
                                </div>
                                <span class="text-[#10B981]">92%</span>
                            </div>
                            <div class="w-[20%] flex justify-end status-healthy">
                                <span class="bg-[#10B981]/10 text-[#10B981] border border-[#10B981]/30 px-1 py-[1px] rounded-[2px] text-[6px] flex items-center gap-1">
                                    <div class="status-dot w-1 h-1 rounded-full"></div>
                                    HEALTHY
                                </span>
                            </div>
                        </div>
                        <!-- Row 2 -->
                        <div class="repo-row flex items-center justify-between py-1 border-l-2 border-l-[#EF4444] pl-2">
                            <span class="text-white w-[30%] truncate">PAYLOAD_SEC</span>
                            <div class="w-[40%] flex items-center gap-2">
                                <div class="flex-1 h-1 bg-[#1F2937] rounded-full overflow-hidden">
                                    <div class="h-full bg-[#EF4444] shadow-[0_0_4px_#EF4444] progress-bar-fill" style="--fill-width: 45%;"></div>
                                </div>
                                <span class="text-[#EF4444]">45%</span>
                            </div>
                            <div class="w-[20%] flex justify-end status-critical">
                                <span class="bg-[#EF4444]/10 text-[#EF4444] border border-[#EF4444]/30 px-1 py-[1px] rounded-[2px] text-[6px] flex items-center gap-1">
                                    <div class="status-dot w-1 h-1 rounded-full"></div>
                                    CRITICAL
                                </span>
                            </div>
                        </div>
                        <!-- Row 3 -->
                        <div class="repo-row flex items-center justify-between py-1 border-l-2 border-l-[#F59E0B] pl-2">
                            <span class="text-white w-[30%] truncate">AUTH_GATEWAY</span>
                            <div class="w-[40%] flex items-center gap-2">
                                <div class="flex-1 h-1 bg-[#1F2937] rounded-full overflow-hidden">
                                    <div class="h-full bg-[#F59E0B] shadow-[0_0_4px_#F59E0B] progress-bar-fill" style="--fill-width: 78%;"></div>
                                </div>
                                <span class="text-[#F59E0B]">78%</span>
                            </div>
                            <div class="w-[20%] flex justify-end">
                                <span class="bg-[#F59E0B]/10 text-[#F59E0B] border border-[#F59E0B]/30 px-1 py-[1px] rounded-[2px] text-[6px]">NOMINAL</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Floating AI Insight -->
                <div class="ai-insight-widget absolute bottom-4 left-4 bg-[#080A0F]/90 backdrop-blur-sm border border-[#8B5CF6]/50 rounded p-2 w-48">
                    <div class="font-section-header text-[#8B5CF6] text-[6px] tracking-widest mb-1 flex items-center gap-1">
                        <div class="w-1.5 h-1.5 rounded-full bg-[#8B5CF6] animate-pulse"></div>
                        AI INSIGHT
                    </div>
                    <div class="font-body-md text-outline text-[7px] leading-tight">
                        Optimization detected in SYS_CORE_V2. Refactoring could yield 8% speedup.
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
