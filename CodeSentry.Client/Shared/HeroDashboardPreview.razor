                <div class="flex gap-4 h-[120px] shrink-0">
                    <!-- Tech Debt Score -->
                    <div class="metric-card w-[35%] bg-[#0F1117] border border-[#1F2937] rounded-lg p-3 flex flex-col items-center justify-center relative overflow-hidden">
                        <span class="absolute top-2 left-3 font-section-header text-[8px] text-outline tracking-widest">TECH DEBT SCORE</span>
                        <div class="hex-gauge w-16 h-16 bg-[#0F1117] border-2 border-accent flex flex-col items-center justify-center mt-3" style="clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);">
