                        <div class="flex items-end justify-between">
                            <span class="font-data-lg text-white text-2xl font-bold">1,024</span>
                            <span class="text-[8px] text-[#10B981] font-data-sm bg-[#10B981]/10 px-1 py-0.5 rounded flex items-center">↓12%</span>
                        </div>
                    </div>
                    
                    <div class="metric-card w-[21%] bg-[#0F1117] border border-[#1F2937] border-l-2 border-l-[#8B5CF6] rounded-lg p-3 flex flex-col justify-between">
