                            <div class="text-[6px] text-outline border border-outline-variant/30 px-1.5 py-0.5 rounded">7D</div>
                            <div class="text-[6px] text-outline border border-outline-variant/30 px-1.5 py-0.5 rounded">30D</div>
                        </div>
                    </div>
                    <div class="flex-1 relative z-10 w-full overflow-hidden">
                        <svg class="absolute inset-0 w-full h-full" preserveAspectRatio="none" viewBox="0 0 400 80">
