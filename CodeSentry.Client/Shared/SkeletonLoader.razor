@if (Type == "table")
{
    @for (int i = 0; i < Count; i++)
    {
        <tr class="animate-pulse border-b border-outline-variant/10">
            @for (int col = 0; col < Columns; col++)
            {
                <td class="px-4 py-4">
                    <div class="h-4 bg-outline-variant/20 rounded @(col == 0 ? "w-3/4" : "w-1/2")"></div>
                </td>
            }
        </tr>
    }
}
else if (Type == "card")
{
    @for (int i = 0; i < Count; i++)
    {
        <div class="animate-pulse glass-panel level-1-border rounded p-5 flex flex-col justify-between bg-[#0F1117] h-32">
            <div class="h-4 bg-outline-variant/20 rounded w-1/2 mb-4"></div>
            <div class="h-8 bg-outline-variant/20 rounded w-1/3"></div>
        </div>
    }
}
else
{
    <div class="flex flex-col items-center justify-center py-12 gap-4 animate-pulse">
        <div class="w-12 h-12 rounded-full bg-outline-variant/20"></div>
        <div class="h-4 bg-outline-variant/20 rounded w-48"></div>
    </div>
}

@code {
    /// <summary>
    /// Type of skeleton: "table", "card", or "default"
    /// </summary>
    [Parameter] public string Type { get; set; } = "default";

    /// <summary>
    /// Number of skeleton items to generate
    /// </summary>
    [Parameter] public int Count { get; set; } = 3;

    /// <summary>
    /// Number of columns (used only for table type)
    /// </summary>
    [Parameter] public int Columns { get; set; } = 5;
}
