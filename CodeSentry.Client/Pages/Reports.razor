@page "/reports"
@attribute [Authorize]
@using Microsoft.AspNetCore.WebUtilities
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject CodeSentryAI.Services.ToastService Toast

<PageTitle>CodeSentry AI - Reports</PageTitle>

<main class="lg:ml-[64px] mt-12 p-margin min-h-screen w-full lg:w-[calc(100%-64px)] flex flex-col page-enter page-wrapper">
<!-- Tailwind Safelist for Dynamic Classes -->
<div class="hidden border-error border-primary border-tertiary border-[#F59E0B] bg-error/20 bg-primary/20 bg-tertiary/20 bg-[#F59E0B]/20 bg-error/10 bg-primary/10 bg-tertiary/10 text-error text-primary text-tertiary text-[#F59E0B] border-error/30 border-primary/30 border-tertiary/30 border-[#F59E0B]/30 border-l-error border-l-primary border-l-[#F59E0B]"></div>

@if (isLoading)
{
<div class="loading-container" style="min-height: 60vh;"><div class="loading-spinner"></div><span class="font-data-sm">Loading report...</span></div>
}
else if (!hasData)
{
<div class="flex flex-col items-center justify-center py-24 gap-4" style="min-height: 60vh;">
    <span class="material-symbols-outlined text-outline text-6xl opacity-30">lab_profile</span>
    <p class="font-body-md text-outline text-center text-lg">No scans yet - run your first scan</p>
    <button @onclick='() => Nav.NavigateTo("/scan")' class="bg-accent text-white font-label-md px-6 py-3 rounded flex items-center gap-2 shadow-[0_0_15px_rgba(59,130,246,0.4)] btn-primary">
        <span class="material-symbols-outlined">bolt</span> GO TO SCANNER
    </button>
</div>
}
else
{
<!-- Header Bar -->
<div class="bg-surface-container/60 backdrop-blur-md border border-primary/20 p-6 flex flex-col lg:flex-row items-center justify-between gap-6 mb-6">
<div>
<h1 class="font-data-lg text-data-lg text-primary drop-shadow-[0_0_8px_rgba(173,198,255,0.8)] mb-2">@reportRepoName</h1>
<p class="font-data-sm text-data-sm text-outline">@reportSubtitle</p>
</div>
<div class="flex items-center gap-4">
<div class="relative w-24 h-24 flex items-center justify-center hex-bg border border-primary/50 shadow-[0_0_20px_rgba(77,142,255,0.6)]" style="background: @(CodeSentryAI.Utils.UIHelper.GetScoreHex(reportScore))1a; border-color: @CodeSentryAI.Utils.UIHelper.GetScoreHex(reportScore);">
<div class="text-center">
<span class="block font-data-md text-data-md font-bold" style="color: @CodeSentryAI.Utils.UIHelper.GetScoreHex(reportScore)">@reportScore/100</span>
<span class="block font-label-sm text-label-sm uppercase tracking-widest mt-1" style="color: @CodeSentryAI.Utils.UIHelper.GetScoreHex(reportScore)">HEALTH</span>
</div>
</div>
</div>
<div class="flex items-center gap-6 flex-wrap">
<div class="flex gap-4">
<div class="data-chip-clip bg-surface-container-high border-b border-secondary/50 px-4 py-2 flex flex-col" style="border-color: #F59E0B;">
<span class="font-label-sm text-label-sm text-outline uppercase mb-1">ISSUES</span>
<span class="font-data-md text-data-md" style="color: #F59E0B;" id="report-stat-issues">@reportTotalIssues</span>
</div>
<div class="data-chip-clip bg-surface-container-high border-b border-error/50 px-4 py-2 flex flex-col" style="border-color: #EF4444;">
<span class="font-label-sm text-label-sm text-outline uppercase mb-1">CRITICAL</span>
<span class="font-data-md text-data-md" style="color: #EF4444;" id="report-stat-crit">@critCount</span>
</div>
<div class="data-chip-clip bg-surface-container-high border-b border-tertiary/50 px-4 py-2 flex flex-col" style="border-color: #8B5CF6;">
<span class="font-label-sm text-label-sm text-outline uppercase mb-1">DEBT</span>
<span class="font-data-md text-data-md" style="color: #8B5CF6;"><span id="report-stat-debt">@(debtHours.TrimEnd('h'))</span>h</span>
</div>
</div>
<div class="flex gap-4">
<button @onclick="DownloadReport" disabled="@isDownloadingPdf" class="bg-primary/10 glow-border-primary text-primary px-6 py-3 font-label-md text-label-md uppercase tracking-wider hover:bg-primary/20 transition-all flex items-center gap-2">
@if (isDownloadingPdf)
{
<div class="loading-spinner" style="width:16px;height:16px;"></div> <span>GENERATING...</span>
}
else
{
<span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">picture_as_pdf</span> <span>DOWNLOAD PDF REPORT</span>
}
</button>
<button @onclick="DownloadReportCsv" class="bg-tertiary/10 border border-tertiary/30 text-tertiary px-6 py-3 font-label-md text-label-md uppercase tracking-wider hover:bg-tertiary/20 transition-all flex items-center gap-2">
<span class="material-symbols-outlined">table_chart</span> EXPORT CSV
</button>
</div>
</div>
</div>

<!-- Fix Progress Ring -->
<div class="bg-surface-container/30 border border-outline-variant/20 p-4 mb-6 rounded flex items-center gap-6">
    <div class="relative w-[80px] h-[80px] shrink-0">
        <svg class="absolute inset-0 w-full h-full -rotate-90" viewBox="0 0 100 100">
            <circle cx="50" cy="50" fill="none" r="44" stroke="rgba(255, 255, 255, 0.1)" stroke-width="6"></circle>
            <circle class="transition-all duration-500 ease-out" cx="50" cy="50" fill="none" r="44" stroke="@fixRingColor" stroke-dasharray="276.5" stroke-dashoffset="@fixRingOffset" stroke-linecap="round" stroke-width="6"></circle>
        </svg>
        <div class="absolute inset-0 flex flex-col items-center justify-center">
            <span class="font-data-md text-white text-sm font-bold">@fixedCount</span>
            <span class="font-data-sm text-outline text-[10px] uppercase border-t border-outline-variant/30 w-8 text-center pt-0.5 mt-0.5">@reportTotalIssues</span>
        </div>
    </div>
    <div>
        <h3 class="font-section-header text-on-surface">REMEDIATION PROGRESS</h3>
        <p class="font-data-sm text-outline">@fixedCount of @reportTotalIssues issues marked as fixed locally.</p>
    </div>
</div>

<!-- Tabs -->
<div class="flex gap-8 border-b border-outline-variant/30 mb-8 pb-2 overflow-x-auto">
@foreach (var tab in tabs)
{
<button @onclick="() => activeTab = tab" class="font-label-md text-label-md pb-2 uppercase tracking-widest whitespace-nowrap transition-colors @(activeTab == tab ? "text-primary border-b-2 border-primary" : "text-outline hover:text-primary")">@tab</button>
}
</div>

<!-- TAB: OVERVIEW -->
@if (activeTab == "OVERVIEW")
{
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
<div class="lg:col-span-4 flex flex-col gap-6">
<section>
<h2 class="font-section-header text-section-header text-on-surface mb-4">SEVERITY BREAKDOWN</h2>
<div class="flex flex-col gap-3">
<div class="bg-surface-container/40 p-4 border-l-2 border-error flex justify-between items-center"><span class="font-data-sm text-data-sm text-error">CRITICAL</span><span class="font-data-md text-data-md text-error">@critCount</span></div>
<div class="bg-surface-container/40 p-4 border-l-2 border-[#F59E0B] flex justify-between items-center"><span class="font-data-sm text-data-sm text-[#F59E0B]">WARNING</span><span class="font-data-md text-data-md text-[#F59E0B]">@warnCount</span></div>
<div class="bg-surface-container/40 p-4 border-l-2 border-primary flex justify-between items-center"><span class="font-data-sm text-data-sm text-primary">INFO</span><span class="font-data-md text-data-md text-primary">@infoCount</span></div>
</div>
</section>
<section>
<h2 class="font-section-header text-section-header text-on-surface mb-4">TOP AFFECTED FILES</h2>
<div class="bg-surface-container/40 border border-outline-variant/20 flex flex-col divide-y divide-outline-variant/20">
@foreach (var af in topFiles)
{
<div class="p-3"><div class="flex justify-between mb-1"><span class="font-data-sm text-data-sm text-on-surface truncate">@af.Name</span><span class="font-data-sm text-data-sm text-@af.ColorClass">@af.Percentage%</span></div><div class="w-full bg-surface-container-highest h-1"><div class="bg-@af.ColorClass h-1 progress-bar-smooth" style="width: @(af.Percentage)%"></div></div></div>
}
</div>
</section>
</div>
<div class="lg:col-span-5 flex flex-col gap-6">
<section>
<h2 class="font-section-header text-section-header text-on-surface mb-4">AI ANALYSIS SUMMARY</h2>
<div class="bg-surface-container/50 p-6 glow-border-secondary relative overflow-hidden">
<div class="absolute top-0 right-0 p-2 opacity-20"><span class="material-symbols-outlined text-4xl text-secondary">memory</span></div>
<p class="font-body-md text-on-surface relative z-10">@summaryText</p>
</div>
</section>
<section>
<h2 class="font-section-header text-section-header text-on-surface mb-4">DETECTED ISSUES (@reportTotalIssues)</h2>
<div class="flex flex-col gap-3" style="max-height: 500px; overflow-y: auto;">
@foreach (var issue in allIssues.Take(20))
{
<div class="bg-surface-container/40 border border-outline-variant/30 p-4 hover:border-primary/50 transition-colors">
<div class="flex items-center gap-3 mb-2 flex-wrap"><span class="px-2 py-0.5 bg-@(issue.ColorClass)/20 text-@issue.ColorClass font-data-sm text-data-sm border border-@(issue.ColorClass)/30">@issue.Severity</span><span class="px-2 py-0.5 bg-primary/10 text-primary font-data-sm text-[10px] border border-primary/20">@issue.Category</span><h3 class="font-label-md text-label-md text-on-surface truncate">@issue.Title</h3></div>
<div class="flex items-center gap-3 mb-2"><div class="flex-1 bg-surface-container-highest h-1.5 rounded-full overflow-hidden" title="Confidence: @(issue.ConfidenceScore)%"><div class="h-full rounded-full transition-all" style="width: @(issue.ConfidenceScore)%; background: @issue.ConfidenceColor;"></div></div><span class="font-data-sm text-[10px] px-1.5 py-0.5 border rounded" style="color: @issue.ConfidenceColor; border-color: @(issue.ConfidenceColor)40;">@issue.ConfidenceLabel @(issue.ConfidenceScore)%</span></div>
<p class="font-data-sm text-data-sm text-outline mb-2">@issue.Location</p>
<p class="font-body-md text-outline text-sm mb-2">@issue.Description</p>
@if (!string.IsNullOrEmpty(issue.DataFlowTrace))
{
<div class="bg-surface-container-highest/60 border border-error/20 p-2 mb-2 font-mono text-[11px] text-error/90 overflow-x-auto"><span class="text-outline mr-1">🚦</span>@issue.DataFlowTrace</div>
}
<div class="flex justify-between items-center mt-2">
<label class="flex items-center gap-2 cursor-pointer group select-none">
    <input type="checkbox" class="form-checkbox bg-surface-container border-outline-variant rounded text-primary focus:ring-primary w-4 h-4" checked="@IsFixed(issue)" @onchange="(e) => ToggleIssueFixed(issue, e.Value)" />
    <span class="font-label-sm text-outline group-hover:text-white transition-colors">MARK AS FIXED</span>
</label>
<button @onclick="() => ToggleFix(issue.FilePath + issue.LineNumber)" class="font-label-md text-label-md text-primary hover:text-primary-fixed flex items-center gap-1">@(IsExpanded(issue.FilePath + issue.LineNumber) ? "HIDE FIX" : "VIEW FIX") <span class="material-symbols-outlined text-sm">@(IsExpanded(issue.FilePath + issue.LineNumber) ? "expand_less" : "arrow_forward")</span></button>
</div>
@if (IsExpanded(issue.FilePath + issue.LineNumber))
{
<div class="fix-panel mt-3"><div class="flex items-center gap-2 mb-2"><span class="material-symbols-outlined text-primary text-sm">auto_fix_high</span><span class="text-primary font-bold">Suggested Fix</span></div><pre class="whitespace-pre-wrap text-on-surface-variant text-sm">@issue.Suggestion</pre></div>
}
</div>
}
@if (allIssues.Count > 20)
{
<p class="text-outline text-center py-2 font-data-sm">Showing 20 of @allIssues.Count issues - download full report for all</p>
}
</div>
</section>
</div>
<div class="lg:col-span-3 flex flex-col gap-6">
<section>
<h2 class="font-section-header text-section-header text-on-surface mb-4">QUICK FIXES</h2>
<div class="flex flex-col gap-3">
@foreach (var issue in allIssues.Where(i => i.Severity == "Critical").Take(5))
{
<div class="bg-surface-container/40 border border-outline-variant/20 p-3 flex flex-col gap-2">
<div class="flex justify-between items-start"><span class="font-label-md text-label-md text-on-surface truncate">@issue.Title</span><span class="px-1.5 py-0.5 bg-error/10 text-error font-data-sm text-[10px] border border-error/30">@issue.EffortLevel</span></div>
<span class="font-data-sm text-data-sm text-outline truncate">@issue.FilePath</span>
<button @onclick="() => ApplyFix(issue)" class="w-full mt-2 border border-primary text-primary py-1.5 font-label-sm text-label-sm uppercase hover:bg-primary/10 transition-colors">@(IsExpanded(issue.Title) ? "HIDE FIX" : "APPLY FIX")</button>
@if (IsExpanded(issue.Title))
{
<div class="fix-panel"><pre class="whitespace-pre-wrap text-on-surface-variant text-sm">@issue.Suggestion</pre></div>
}
</div>
}
</div>
</section>
<section>
<h2 class="font-section-header text-section-header text-on-surface mb-4">SCAN METADATA</h2>
<div class="bg-surface-container/40 border border-outline-variant/20 p-4 font-data-sm text-data-sm flex flex-col gap-2 text-outline">
<div class="flex justify-between"><span>Duration:</span> <span class="text-on-surface">@scanDuration</span></div>
<div class="flex justify-between"><span>Files:</span> <span class="text-on-surface">@fileCount</span></div>
<div class="flex justify-between"><span>AI:</span> <span class="text-secondary">CodeSentry Engine v2.0</span></div>
<div class="flex justify-between"><span>Engine:</span> <span class="text-on-surface">Static Analysis (Offline)</span></div>
<div class="flex justify-between"><span>Scan ID:</span> <span class="text-primary">@(loadedScanId ?? "N/A")</span></div>
</div>
</section>
</div>
</div>
}
else if (activeTab == "ACTION PLAN")
{
    <h2 class="font-section-header text-section-header text-on-surface mb-4">REMEDIATION ACTION PLAN</h2>
    <div class="flex flex-col gap-4">
        @{ int rank = 1; }
        @foreach (var item in actionPlanItems)
        {
            var rankColor = rank == 1 ? "bg-[#EF4444] text-white" : rank == 2 ? "bg-[#F97316] text-white" : rank == 3 ? "bg-[#F59E0B] text-white" : rank == 4 ? "bg-[#3B82F6] text-white" : "bg-[#6B7280] text-white";
            var confColor = item.FixConfidence >= 80 ? "text-[#10B981] border-[#10B981]" : item.FixConfidence >= 50 ? "text-[#F59E0B] border-[#F59E0B]" : "text-[#EF4444] border-[#EF4444]";
            var confText = item.FixConfidence >= 80 ? $"{item.FixConfidence}% Safe to Fix" : $"{item.FixConfidence}% — Review First";
            
            <div class="bg-surface-container/40 border border-outline-variant/30 p-5 relative overflow-hidden rounded">
                <div class="flex items-start gap-4">
                    <div class="@rankColor font-data-lg text-2xl w-12 h-12 flex items-center justify-center shrink-0 shadow-md">#@rank</div>
                    <div class="flex-1 flex flex-col gap-2">
                        <h3 class="font-label-md text-on-surface text-lg">@item.RuleName <span class="text-outline font-normal">— @item.InstanceCount instances across @item.AffectedFiles.Count files</span></h3>
                        <div class="flex items-center gap-4 flex-wrap">
                            <span class="font-data-lg text-tertiary text-xl">@item.DollarCost.ToString("C0") <span class="text-xs text-outline font-body-md inline-block align-middle ml-1">in engineering debt (~@item.EstimatedHours.ToString("F1") hours at $85/hr)</span></span>
                        </div>
                        <div class="flex items-center gap-3 mt-2">
                            <span class="px-2 py-1 font-data-sm text-[11px] border @confColor bg-surface-container rounded-sm uppercase">@confText</span>
                            <span class="px-2 py-1 font-data-sm text-[11px] border border-primary/30 text-primary bg-primary/10 rounded-sm">+@item.ScoreImpact.ToString("F0") pts if resolved</span>
                            <span class="px-2 py-1 font-data-sm text-[11px] border border-outline-variant/30 text-outline rounded-sm flex items-center"><span class="material-symbols-outlined text-[14px] mr-1">schedule</span> ~@Math.Ceiling(item.EstimatedHours * 60) min</span>
                        </div>
                        <div class="mt-4 flex items-center justify-between">
                            <button @onclick='() => ToggleFix(item.RuleName + "_files")' class="font-label-sm text-primary uppercase tracking-wider hover:underline flex items-center gap-1">
                                @(IsExpanded(item.RuleName + "_files") ? "HIDE FILES" : "VIEW AFFECTED FILES") <span class="material-symbols-outlined text-sm">@(IsExpanded(item.RuleName + "_files") ? "expand_less" : "expand_more")</span>
                            </button>
                            <button @onclick="() => CopyAllFixes(item)" class="bg-primary/20 text-primary border border-primary/50 font-label-sm px-4 py-2 uppercase hover:bg-primary/30 transition-colors flex items-center gap-2 rounded-sm">
                                <span class="material-symbols-outlined text-sm">content_copy</span> COPY ALL FIXES
                            </button>
                        </div>
                        @if (IsExpanded(item.RuleName + "_files"))
                        {
                            <div class="mt-3 p-3 bg-surface-container-highest/50 border border-outline-variant/20 max-h-48 overflow-y-auto">
                                <ul class="list-disc pl-5 font-data-sm text-outline text-xs flex flex-col gap-1">
                                    @foreach (var f in item.AffectedFiles)
                                    {
                                        <li>@f</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
            rank++;
        }
        @if(actionPlanItems.Count == 0)
        {
            <div class="p-8 text-center text-outline bg-surface-container/20 border border-outline-variant/20">No action plan available.</div>
        }
    </div>
}
else if (activeTab == "SECURITY")
{
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
<div>
<h2 class="font-section-header text-section-header text-on-surface mb-4">SECURITY VULNERABILITIES (@(allIssues.Count(i => i.Category == "Security")))</h2>
<div class="flex flex-col gap-3" style="max-height: 600px; overflow-y: auto;">
@{
    var secGroups = allIssues.Where(i => i.Category == "Security").GroupBy(i => i.Title).ToList();
}
@foreach (var group in secGroups)
{
    var ruleName = group.Key;
    var instances = group.ToList();
    var firstIssue = instances.First();
    var fileCount = instances.Select(i => i.FilePath).Distinct().Count();
    
    <div class="bg-surface-container/40 border border-outline-variant/30 p-4 border-l-2 border-@firstIssue.ColorClass">
        <div class="flex justify-between items-start cursor-pointer select-none" @onclick='() => ToggleFix("sec_" + ruleName)'>
            <div>
                <div class="flex items-center gap-3 mb-1">
                    <span class="px-2 py-0.5 bg-@(firstIssue.ColorClass)/20 text-@firstIssue.ColorClass font-data-sm text-data-sm border border-@(firstIssue.ColorClass)/30">@firstIssue.Severity</span>
                    <h3 class="font-label-md text-label-md text-on-surface">@ruleName — @instances.Count instances</h3>
                </div>
                <p class="font-data-sm text-outline">Affects @fileCount files — 1 fix pattern solves all</p>
            </div>
            <span class="material-symbols-outlined text-outline">@(IsExpanded("sec_" + ruleName) ? "expand_less" : "expand_more")</span>
        </div>
        
        @if(IsExpanded("sec_" + ruleName))
        {
            <div class="mt-4 pt-4 border-t border-outline-variant/20 flex flex-col gap-3">
                <button @onclick:stopPropagation="true" @onclick="() => CopySecurityFixes(instances)" class="self-start bg-primary/20 text-primary border border-primary/50 font-label-sm px-3 py-1.5 uppercase hover:bg-primary/30 transition-colors flex items-center gap-2 rounded-sm mb-2">
                    <span class="material-symbols-outlined text-sm">content_copy</span> BATCH COPY FIX
                </button>
                @foreach (var issue in instances)
                {
                    <div class="bg-surface-container-highest/30 p-3 rounded border border-outline-variant/10">
                        <p class="font-data-sm text-on-surface mb-1">@issue.FilePath:<span class="text-primary">@issue.LineNumber</span></p>
                        @if(!string.IsNullOrEmpty(issue.Description))
                        {
                            <p class="font-body-md text-outline text-xs mb-2">@issue.Description</p>
                        }
                    </div>
                }
                <div class="fix-panel mt-2">
                    <p class="font-body-md text-primary text-sm mb-1">💡 @firstIssue.Suggestion</p>
                </div>
            </div>
        }
    </div>
}
</div>
</div>
<div>
<h2 class="font-section-header text-section-header text-on-surface mb-4">THREAT ASSESSMENT</h2>
<div class="bg-surface-container/40 border border-outline-variant/20 p-6">
<div class="flex items-center gap-4 mb-4"><span class="material-symbols-outlined text-error text-3xl">shield</span><span class="font-data-lg text-error text-2xl">@critCount Critical</span></div>
<p class="font-body-md text-outline">@(critCount > 0 ? "Immediate remediation recommended for all critical security issues." : "No critical security issues detected - great job!") Run OWASP dependency check for full vulnerability mapping.</p>
<div class="mt-4 flex flex-col gap-2 text-sm">
<div class="flex justify-between text-outline"><span>Security Issues:</span><span class="text-error">@(allIssues.Count(i => i.Category == "Security"))</span></div>
<div class="flex justify-between text-outline"><span>Dependency Vulns:</span><span class="text-[#F59E0B]">@(allIssues.Count(i => i.Category == "Dependency"))</span></div>
</div>
</div>
</div>
</div>
}
else if (activeTab == "TECH DEBT")
{
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
<div class="bg-surface-container/40 border border-outline-variant/20 p-6 text-center">
<span class="font-data-lg text-[#F59E0B] text-4xl">@debtHours</span>
<p class="font-section-header text-outline mt-2">ESTIMATED DEBT</p>
</div>
<div class="bg-surface-container/40 border border-outline-variant/20 p-6 text-center">
<span class="font-data-lg text-primary text-4xl">@(allIssues.Count(i => i.Category == "Quality"))</span>
<p class="font-section-header text-outline mt-2">QUALITY ISSUES</p>
</div>
<div class="bg-surface-container/40 border border-outline-variant/20 p-6 text-center">
<span class="font-data-lg text-tertiary text-4xl">@reportScore</span>
<p class="font-section-header text-outline mt-2">HEALTH SCORE</p>
</div>
</div>
<h2 class="font-section-header text-section-header text-on-surface mb-4">QUALITY & TECH DEBT ISSUES</h2>
<div class="flex flex-col gap-3" style="max-height: 500px; overflow-y: auto;">
@foreach (var issue in allIssues.Where(i => i.Category == "Quality" || i.Category == "Performance"))
{
<div class="bg-surface-container/40 p-4 border-l-2 border-@issue.ColorClass flex flex-col gap-1">
<div class="flex items-center gap-3"><span class="px-2 py-0.5 bg-@(issue.ColorClass)/20 text-@issue.ColorClass font-data-sm text-[10px] border border-@(issue.ColorClass)/30">@issue.Severity</span><span class="font-label-md text-on-surface">@issue.Title</span></div>
<span class="font-data-sm text-outline">@issue.Location</span>
<span class="font-body-md text-outline text-sm">@issue.Description</span>
</div>
}
</div>
}
else if (activeTab == "AI SUGGESTIONS")
{
<h2 class="font-section-header text-section-header text-on-surface mb-4">AI-POWERED SUGGESTIONS (@allIssues.Count)</h2>
<div class="flex flex-col gap-3" style="max-height: 600px; overflow-y: auto;">
@foreach (var issue in allIssues.Where(i => !string.IsNullOrEmpty(i.Suggestion)))
{
<div class="bg-surface-container/40 border border-outline-variant/20 p-4">
<div class="flex justify-between items-start mb-2 flex-wrap gap-2">
<div class="flex items-center gap-2"><span class="px-2 py-0.5 bg-@(issue.ColorClass)/20 text-@issue.ColorClass font-data-sm text-[10px] border border-@(issue.ColorClass)/30">@issue.Severity</span><span class="font-label-md text-on-surface">@issue.Title</span></div>
<span class="px-1.5 py-0.5 bg-primary/10 text-primary font-data-sm text-[10px] border border-primary/30">@issue.Category</span>
</div>
<p class="font-data-sm text-outline mb-2">@issue.Location</p>
<div class="fix-panel">
<div class="flex items-center gap-2 mb-2"><span class="material-symbols-outlined text-primary text-sm">auto_fix_high</span><span class="text-primary font-bold">Suggested Fix</span></div>
<pre class="whitespace-pre-wrap text-on-surface-variant text-sm">@issue.Suggestion</pre>
</div>
</div>
}
</div>
}
else if (activeTab == "FILES")
{
<h2 class="font-section-header text-section-header text-on-surface mb-4">AFFECTED FILES (@fileSummaries.Count)</h2>
<div class="bg-surface-container/40 border border-outline-variant/20 rounded overflow-hidden overflow-x-auto" style="max-height: 600px; overflow-y: auto;">
    <table class="w-full text-left border-collapse whitespace-nowrap">
        <thead class="bg-[#0F1117] border-b border-outline-variant/50 sticky top-0 z-10 shadow-sm">
            <tr>
                <th class="font-label-sm text-outline uppercase px-4 py-3 font-semibold">File Path</th>
                <th class="font-label-sm text-outline uppercase px-4 py-3 font-semibold text-center">Issues</th>
                <th class="font-label-sm text-outline uppercase px-4 py-3 font-semibold text-center cursor-pointer hover:text-white transition-colors select-none" @onclick='() => SortFiles("RiskScore")'>
                    Risk Score <span class="material-symbols-outlined text-[10px] ml-1 align-middle">@(sortRiskScoreAscending ? "arrow_upward" : "arrow_downward")</span>
                </th>
            </tr>
        </thead>
        <tbody class="font-data-sm text-white">
            @foreach (var fs in fileSummaries)
            {
                var bgRisk = fs.RiskScore >= 30 ? "bg-[#EF4444]" : fs.RiskScore >= 10 ? "bg-[#F59E0B]" : "bg-[#3B82F6]";
                var dotColor = fs.RiskScore >= 30 ? "#EF4444" : fs.RiskScore >= 10 ? "#F59E0B" : "#3B82F6";
                
                <tr class="border-b border-outline-variant/10 hover:bg-white/5 transition-colors">
                    <td class="px-4 py-3">
                        <div class="flex items-center gap-2">
                            <div class="w-2 h-2 rounded-full shrink-0" style="background-color: @dotColor;"></div>
                            <span class="text-on-surface font-mono text-[11px] break-all">@fs.FilePath</span>
                        </div>
                    </td>
                    <td class="px-4 py-3 text-center text-outline">
                        @(fs.CriticalCount + fs.WarningCount + fs.InfoCount)
                    </td>
                    <td class="px-4 py-3 text-center">
                        <span class="inline-block px-3 py-1 rounded text-white font-bold @bgRisk">
                            @fs.RiskScore
                        </span>
                    </td>
                </tr>
            }
            @if(fileSummaries.Count == 0)
            {
                <tr><td colspan="3" class="px-4 py-8 text-center text-outline">No file data available.</td></tr>
            }
        </tbody>
    </table>
</div>
}
else if (activeTab == "API SURFACE")
{
var apiIssues = allIssues.Where(i => i.Category == "ApiSurface").ToList();
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
<div class="bg-surface-container/40 border border-outline-variant/20 p-6 text-center">
<span class="font-data-lg text-error text-4xl">@(apiIssues.Count(i => i.Severity == "Warning" || i.Severity == "Critical"))</span>
<p class="font-section-header text-outline mt-2">UNPROTECTED</p>
</div>
<div class="bg-surface-container/40 border border-outline-variant/20 p-6 text-center">
<span class="font-data-lg text-[#F59E0B] text-4xl">@(apiIssues.Count(i => i.Title.Contains("Validation")))</span>
<p class="font-section-header text-outline mt-2">NO VALIDATION</p>
</div>
<div class="bg-surface-container/40 border border-outline-variant/20 p-6 text-center">
<span class="font-data-lg text-primary text-4xl">@(apiIssues.Count(i => i.Title.Contains("Rate")))</span>
<p class="font-section-header text-outline mt-2">NO RATE LIMIT</p>
</div>
</div>
<h2 class="font-section-header text-section-header text-on-surface mb-4">DISCOVERED ENDPOINTS (@apiIssues.Count findings)</h2>
<div class="flex flex-col gap-3" style="max-height: 600px; overflow-y: auto;">
@foreach (var issue in apiIssues)
{
<div class="bg-surface-container/40 border border-outline-variant/30 p-4 border-l-2" style="border-left-color: @(issue.Severity == "Warning" ? "#EF4444" : issue.Severity == "Info" ? "#3B82F6" : "#F59E0B")">
<div class="flex items-center gap-3 mb-2 flex-wrap">
<span class="px-2 py-0.5 bg-@(issue.ColorClass)/20 text-@issue.ColorClass font-data-sm text-data-sm border border-@(issue.ColorClass)/30">@issue.Severity</span>
<h3 class="font-label-md text-label-md text-on-surface">@issue.Title</h3>
</div>
<div class="flex items-center gap-3 mb-2"><div class="flex-1 bg-surface-container-highest h-1.5 rounded-full overflow-hidden"><div class="h-full rounded-full" style="width: @(issue.ConfidenceScore)%; background: @issue.ConfidenceColor;"></div></div><span class="font-data-sm text-[10px]" style="color: @issue.ConfidenceColor;">@issue.ConfidenceLabel @(issue.ConfidenceScore)%</span></div>
<p class="font-data-sm text-data-sm text-outline mb-2">@issue.Location</p>
<p class="font-body-md text-outline text-sm mb-2">@issue.Description</p>
                        <p class="font-body-md text-primary text-sm">💡 @issue.Suggestion</p>
</div>
}
@if (apiIssues.Count == 0)
{
<div class="text-center py-12 text-outline"><span class="material-symbols-outlined text-4xl opacity-30 block mb-2">api</span><p>No API endpoints detected in this repository.</p></div>
}
</div>
}
}
</main>

@code {
    private List<CodeIssue> allIssues = new();
    private List<AffectedFile> topFiles = new();
    private List<ActionItem> actionPlanItems = new();
    private List<FileSummary> fileSummaries = new();
    private bool sortRiskScoreAscending = false;
    private Dictionary<string, int> fileIssueCounts = new();
    private bool hasData = false;
    private bool isLoading = true;
    private string activeTab = "OVERVIEW";
    private string reportRepoName = "";
    private string reportSubtitle = "";
    private string summaryText = "";
    private string scanDuration = "-";
    private string fileCount = "-";
    private string debtHours = "0h";
    private int reportScore = 0;
    private int reportTotalIssues = 0;
    private int critCount = 0;
    private int warnCount = 0;
    private int infoCount = 0;
    private string? loadedScanId;
    private Dictionary<string, bool> expandedFixes = new();
    private Dictionary<string, bool> fixedIssuesMap = new();
    private bool isDownloadingPdf = false;
    
    private int fixedCount => fixedIssuesMap.Values.Count(v => v);
    private string fixRingColor => fixedCount * 100 / Math.Max(1, reportTotalIssues) > 50 ? "#10B981" : fixedCount * 100 / Math.Max(1, reportTotalIssues) >= 25 ? "#F59E0B" : "#EF4444";
    private string fixRingOffset => (276.5 - (fixedCount / (double)Math.Max(1, reportTotalIssues) * 276.5)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private readonly string[] tabs = { "OVERVIEW", "ACTION PLAN", "SECURITY", "TECH DEBT", "AI SUGGESTIONS", "FILES", "API SURFACE" };

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        loadedScanId = query.TryGetValue("scanId", out var sid) ? sid.ToString() : null;

        try
        {
            var client = HttpClientFactory.CreateClient("CodeSentryAPI");

            ScanResultDto? report = null;

            if (!string.IsNullOrEmpty(loadedScanId))
            {
                // Fetch REAL report data from API
                report = await client.GetFromJsonAsync<ScanResultDto>($"api/scan/{loadedScanId}/report");
            }
            else
            {
                // No scanId - check if any completed scans exist
                var history = await client.GetFromJsonAsync<List<CodeSentryAI.Models.RecentScan>>("api/scan/history");
                if (history != null && history.Count > 0)
                {
                    loadedScanId = history[0].Id;
                    report = await client.GetFromJsonAsync<ScanResultDto>($"api/scan/{loadedScanId}/report");
                }
            }

            if (report != null && report.Issues.Count > 0)
            {
                LoadFromReport(report);
                
                try {
                    actionPlanItems = await client.GetFromJsonAsync<List<ActionItem>>($"api/scan/{loadedScanId}/action-plan") ?? new();
                } catch { /* ignore if not available */ }
            }
            else
            {
                hasData = false;
            }
        }
        finally
        {
            isLoading = false;
        }

        if (hasData)
        {
            await LoadFixedState();
            StateHasChanged();
            try {
                await Task.Delay(100);
                await JS.InvokeVoidAsync("codeSentryInterop.countUp", "report-stat-issues", reportTotalIssues, 1000);
                await JS.InvokeVoidAsync("codeSentryInterop.countUp", "report-stat-crit", critCount, 1000);
                double debt = (critCount * 4.0) + (warnCount * 1.5) + (infoCount * 0.5);
                await JS.InvokeVoidAsync("codeSentryInterop.countUp", "report-stat-debt", (int)debt, 1000);
            } catch {}
        }
    }

    private void LoadFromReport(ScanResultDto report)
    {
        allIssues = report.Issues;
        reportScore = report.Score;
        reportTotalIssues = report.TotalIssues;
        critCount = allIssues.Count(i => i.Severity == "Critical");
        warnCount = allIssues.Count(i => i.Severity == "Warning");
        infoCount = allIssues.Count(i => i.Severity == "Info");

        double debt = (critCount * 4.0) + (warnCount * 1.5) + (infoCount * 0.5);
        debtHours = $"{debt:F0}h";

        reportRepoName = loadedScanId ?? "SCAN";
        reportSubtitle = $"Scan completed \u2022 {DateTime.Now:HH:mm} local \u2022 {reportTotalIssues} findings";

        // Build summary from real data
        var summaryParts = new List<string>();
        summaryParts.Add($"{reportTotalIssues} issues found across the repository.");
        if (critCount > 0)
        {
            var topCrit = allIssues.FirstOrDefault(i => i.Severity == "Critical");
            if (topCrit != null)
                summaryParts.Add($"{critCount} critical: {topCrit.Title} in {topCrit.FilePath} requires immediate action.");
        }
        if (warnCount > 0) summaryParts.Add($"{warnCount} warnings detected.");
        summaryParts.Add($"Health score: {reportScore}/100. Estimated {debtHours} of technical debt.");
        summaryText = string.Join(" ", summaryParts);

        // Build top affected files from real issues
        fileIssueCounts = allIssues
            .Where(i => !string.IsNullOrEmpty(i.FilePath))
            .GroupBy(i => i.FilePath)
            .ToDictionary(g => g.Key, g => g.Count());

        topFiles = fileIssueCounts
            .OrderByDescending(kv => kv.Value)
            .Take(10)
            .Select(kv => new AffectedFile
            {
                Name = kv.Key,
                Percentage = reportTotalIssues > 0 ? (int)Math.Round((double)kv.Value / reportTotalIssues * 100) : 0,
                ColorClass = kv.Value >= 5 ? "error" : kv.Value >= 3 ? "[#F59E0B]" : "primary"
            })
            .ToList();

        fileSummaries = report.FileSummaries ?? new();
        SortFiles("RiskScore");

        // Parse duration from scan message if available
        var msg = report.TimeAgo ?? "";
        scanDuration = "-";
        fileCount = topFiles.Count.ToString();

        hasData = true;
    }

    private void SortFiles(string column)
    {
        if (column == "RiskScore")
        {
            if (sortRiskScoreAscending)
                fileSummaries = fileSummaries.OrderBy(f => f.RiskScore).ToList();
            else
                fileSummaries = fileSummaries.OrderByDescending(f => f.RiskScore).ToList();
            sortRiskScoreAscending = !sortRiskScoreAscending;
        }
    }

    private void ToggleFix(string key)
    {
        if (expandedFixes.ContainsKey(key))
            expandedFixes[key] = !expandedFixes[key];
        else
            expandedFixes[key] = true;
    }

    private string GetIssueKey(CodeIssue issue) => $"{issue.FilePath}:{issue.LineNumber}";
    private bool IsFixed(CodeIssue issue) => fixedIssuesMap.GetValueOrDefault(GetIssueKey(issue), false);

    private async Task ToggleIssueFixed(CodeIssue issue, object? checkedValue)
    {
        bool isFixed = checkedValue as bool? ?? false;
        var key = GetIssueKey(issue);
        fixedIssuesMap[key] = isFixed;
        
        try {
            var lsKey = $"codesentry_fixed_{loadedScanId}_{key}";
            if (isFixed)
                await JS.InvokeVoidAsync("localStorage.setItem", lsKey, "true");
            else
                await JS.InvokeVoidAsync("localStorage.removeItem", lsKey);
        } catch {}
    }

    private async Task LoadFixedState()
    {
        try {
            foreach (var issue in allIssues)
            {
                var key = GetIssueKey(issue);
                var lsKey = $"codesentry_fixed_{loadedScanId}_{key}";
                var val = await JS.InvokeAsync<string>("localStorage.getItem", lsKey);
                if (val == "true")
                {
                    fixedIssuesMap[key] = true;
                }
            }
            StateHasChanged();
        } catch { }
    }

    private bool IsExpanded(string key) => expandedFixes.ContainsKey(key) && expandedFixes[key];

    /// <summary>
    /// Expands the fix panel AND copies the suggestion to clipboard.
    /// </summary>
    private async Task ApplyFix(CodeIssue issue)
    {
        ToggleFix(issue.Title);
        if (!string.IsNullOrEmpty(issue.Suggestion) && IsExpanded(issue.Title))
        {
            try
            {
                await JS.InvokeVoidAsync("codeSentryInterop.copyToClipboard", issue.Suggestion);
                Toast.ShowSuccess("Fix copied to clipboard!");
            }
            catch { /* clipboard unavailable - fix still shown */ }
        }
    }

    private async Task CopyAllFixes(ActionItem item)
    {
        var fixes = allIssues.Where(i => i.Title == item.RuleName && !string.IsNullOrEmpty(i.Suggestion)).ToList();
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Batch Fixes for {item.RuleName}");
        foreach (var fix in fixes)
        {
            sb.AppendLine($"\n--- File: {fix.FilePath} ---");
            sb.AppendLine(fix.Suggestion);
        }
        try
        {
            await JS.InvokeVoidAsync("codeSentryInterop.copyToClipboard", sb.ToString());
            Toast.ShowSuccess("All fixes copied to clipboard!");
        }
        catch { }
    }

    private async Task CopySecurityFixes(List<CodeIssue> instances)
    {
        var firstIssue = instances.FirstOrDefault();
        if (firstIssue == null || string.IsNullOrEmpty(firstIssue.Suggestion)) return;
        
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"Batch Fixes for {firstIssue.Title}");
        foreach (var fix in instances)
        {
            sb.AppendLine($"\n--- File: {fix.FilePath} ---");
            sb.AppendLine(firstIssue.Suggestion);
        }
        try
        {
            await JS.InvokeVoidAsync("codeSentryInterop.copyToClipboard", sb.ToString());
            Toast.ShowSuccess("All fixes copied to clipboard!");
        }
        catch { }
    }

    private async Task DownloadReport()
    {
        if (string.IsNullOrEmpty(loadedScanId) || isDownloadingPdf) return;
        isDownloadingPdf = true;
        StateHasChanged();
        try
        {
            var client = HttpClientFactory.CreateClient("CodeSentryAPI");
            var response = await client.GetAsync($"api/scan/{loadedScanId}/report/pdf");
            if (response.IsSuccessStatusCode)
            {
                var bytes = await response.Content.ReadAsByteArrayAsync();
                var base64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("codeSentryInterop.downloadPdf",
                    $"codesentry-report-{loadedScanId}.pdf", base64);
                Toast.ShowSuccess("PDF report downloaded!");
            }
            else
            {
                Toast.ShowError("Failed to generate PDF report.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Download failed: {ex.Message}");
        }
        finally
        {
            isDownloadingPdf = false;
            StateHasChanged();
        }
    }

    private string EscapeCsvField(string field)
    {
        if (string.IsNullOrEmpty(field)) return "";
        field = field.Replace("\"", "\"\"");
        // Prevent CSV Injection (Formula Injection)
        if (field.StartsWith('=') || field.StartsWith('+') || field.StartsWith('-') || field.StartsWith('@'))
            field = "'" + field;
        return field;
    }

    private async Task DownloadReportCsv()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Severity,Category,Title,File,Line,Confidence,Suggestion");
        foreach (var issue in allIssues)
        {
            var title = EscapeCsvField(issue.Title);
            var file = EscapeCsvField(issue.FilePath);
            var suggestion = EscapeCsvField(issue.Suggestion?.Replace("\n", " ") ?? string.Empty);
            sb.AppendLine($"\"{issue.Severity}\",\"{issue.Category}\",\"{title}\",\"{file}\",{issue.LineNumber},{issue.ConfidenceScore},\"{suggestion}\"");
        }
        var fileName = $"codesentry-report-{loadedScanId ?? "latest"}.csv";
        await JS.InvokeVoidAsync("codeSentryInterop.downloadFile", fileName, sb.ToString());
    }
}
