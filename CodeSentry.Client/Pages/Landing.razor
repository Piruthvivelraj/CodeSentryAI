            <div class="flex flex-col gap-2 highlight-item">
                <span class="material-symbols-outlined text-4xl text-primary">speed</span>
                <span class="font-body-md text-outline uppercase text-xs tracking-widest">Real-Time Analysis</span>
            </div>
            <div class="flex flex-col gap-2 pl-8 highlight-item">
