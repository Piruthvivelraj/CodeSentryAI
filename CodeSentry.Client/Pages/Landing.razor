@page "/"
@using CodeSentryAI.Shared
@layout CodeSentryAI.Layout.EmptyLayout
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>CodeSentry AI - AI-Powered Code Review</PageTitle>

<!-- Ambient Glows -->
<div class="fixed top-[-20%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-primary-container/20 blur-[120px] pointer-events-none z-[-1]"></div>
<div class="fixed bottom-[-20%] right-[-10%] w-[50vw] h-[50vw] rounded-full bg-secondary-container/20 blur-[120px] pointer-events-none z-[-1]"></div>

<!-- TopNavBar -->
<nav class="fixed top-0 w-full z-50 bg-[#080A0F]/80 backdrop-blur-xl border-b border-primary/20 shadow-[0_4px_20px_rgba(59,130,246,0.15)]">
    <div class="flex justify-between items-center px-margin py-4 max-w-[1280px] mx-auto w-full">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary text-2xl" style="font-variation-settings: 'FILL' 1;">hexagon</span>
            <span class="font-section-header tracking-tighter text-white uppercase">CodeSentry AI</span>
        </div>
        <div class="hidden md:flex items-center gap-8">
            <a class="text-white font-body-md nav-link" href="#features">Features</a>
            <a class="text-white font-body-md nav-link" href="#pricing">Pricing</a>
            <a class="text-white font-body-md nav-link" href="#testimonials">Docs</a>
            <a class="text-white font-body-md nav-link" href="/login">Changelog</a>
        </div>
        <div class="flex items-center gap-4">
            <a class="hidden md:block text-outline hover:text-white font-label-md transition-colors" href="/login">Sign In</a>
            <a class="bg-primary text-white font-label-md px-4 py-2 rounded flex items-center gap-2 shadow-[0_0_15px_rgba(173,198,255,0.4)] btn-primary" href="/scan">
                <span>START FREE SCAN</span>
                <span class="material-symbols-outlined text-sm">rocket_launch</span>
            </a>
            <!-- Issue 13: Mobile hamburger menu -->
            <button @onclick="ToggleMobileMenu" class="md:hidden text-white p-1">
                <span class="material-symbols-outlined text-2xl">@(showMobileMenu ? "close" : "menu")</span>
            </button>
        </div>
    </div>
    <!-- Mobile dropdown menu (Issue 13) -->
    @if (showMobileMenu)
    {
        <div class="md:hidden bg-[#080A0F]/95 backdrop-blur-xl border-t border-primary/20 px-margin py-4 flex flex-col gap-4">
            <a class="text-white font-body-md py-2 nav-link" href="#features" @onclick="CloseMobileMenu">Features</a>
            <a class="text-white font-body-md py-2 nav-link" href="#pricing" @onclick="CloseMobileMenu">Pricing</a>
            <a class="text-white font-body-md py-2 nav-link" href="#testimonials" @onclick="CloseMobileMenu">Docs</a>
            <a class="text-white font-body-md py-2 nav-link" href="/login" @onclick="CloseMobileMenu">Sign In</a>
            <a class="bg-primary text-white font-label-md px-4 py-3 rounded text-center btn-primary" href="/scan" @onclick="CloseMobileMenu">START FREE SCAN</a>
        </div>
    }
</nav>

<main class="w-full max-w-[1280px] mx-auto relative z-10 flex flex-col px-margin pb-24 gap-32 page-wrapper">
    <!-- Hero Section -->
    <section class="hero-content scroll-animate scroll-animate min-h-screen flex flex-col items-center justify-center text-center pt-[80px] gap-6 w-full relative">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#8B5CF6]/30 bg-[#8B5CF6]/10 badge-pill hero-stats">
            <span class="material-symbols-outlined text-[#8B5CF6] text-sm" style="font-variation-settings: 'FILL' 1;">bolt</span>
            <span class="font-data-sm text-[#8B5CF6] tracking-widest uppercase">Powered by CodeSentry Engine v2.0 - real-time static analysis, zero cloud dependency</span>
        </div>
        
