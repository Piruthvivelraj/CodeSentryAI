<CascadingAuthenticationState>
    <ErrorBoundary>
        <ChildContent>
            <Router AppAssembly="@typeof(App).Assembly">
                <Found Context="routeData">
                    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                        <NotAuthorized>
                            <CodeSentryAI.Layout.RedirectToLogin />
                        </NotAuthorized>
                    </AuthorizeRouteView>
                    <FocusOnNavigate RouteData="@routeData" Selector="h1, main" />
                </Found>
                <NotFound>
                    <LayoutView Layout="@typeof(MainLayout)">
                        <CodeSentryAI.Pages.NotFound/>
                    </LayoutView>
                </NotFound>
            </Router>
        </ChildContent>
        <ErrorContent Context="ex">
            <div style="min-height:100vh; display:flex; align-items:center; justify-content:center; background:#080A0F; font-family:'Inter',monospace;">
                <div style="text-align:center; padding:2rem; border:1px solid rgba(239,68,68,0.4); background:rgba(239,68,68,0.05); max-width:560px; width:100%;">
                    <span style="display:block; font-size:3rem; color:#EF4444; margin-bottom:1rem;">⚠</span>
                    <h2 style="font-size:1.5rem; color:#EF4444; letter-spacing:0.2em; text-transform:uppercase; margin-bottom:0.75rem;">SYSTEM ERROR</h2>
                    <p style="color:#6b7280; font-size:0.875rem; margin-bottom:1.5rem; word-break:break-word;">@ex.Message</p>
                    <a href="/" style="display:inline-flex; align-items:center; gap:0.5rem; background:#3b82f6; color:#fff; padding:0.75rem 1.5rem; text-decoration:none; font-size:0.875rem; letter-spacing:0.1em; text-transform:uppercase;">
                        ← RETURN TO BASE
                    </a>
                </div>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</CascadingAuthenticationState>
